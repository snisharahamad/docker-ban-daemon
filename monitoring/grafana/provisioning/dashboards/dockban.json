{
  "title": "Dockban — Observabilité WAF & Pare-feu",
  "uid": "dockban-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "IP Bannies Actives",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "dockban_active_bans", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Logs Analysés (Total)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "dockban_logs_processed_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hits Regex L1 (Total)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "dockban_regex_hits_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latence LLM P95 (s)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dockban_llm_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Décisions par Moteur et Verdict (req/min)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (engine, verdict) (rate(dockban_decisions_total[1m])) * 60",
          "legendFormat": "{{engine}} / {{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Distribution Latence Ollama (P50 / P95)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(dockban_llm_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(dockban_llm_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        }
      ]
    }
  ]
}
